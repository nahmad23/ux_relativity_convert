{
	"users": [{
			"name": "{{ rabbitmq_creds.rabbitadmin_user }}",
			"password_hash": "{{ rabbitmq_creds.rabbitadmin_pwhash }}",
			"hashing_algorithm": "rabbit_password_hashing_sha256",
			"tags": ["administrator"],
			"limits": {}
		},
		{
			"name": "{{ rabbitmq_creds.reladmin_user }}",
			"password_hash": "{{ rabbitmq_creds.reladmin_pwhash }}",
			"hashing_algorithm": "rabbit_password_hashing_sha256",
			"tags": ["management"],
			"limits": {}
		}
	],
	"vhosts": [{
		"name": "/"
	}, {
		"name": "Relativity"
	}],
	"permissions": [{
			"user": "{{ rabbitmq_creds.rabbitadmin_user }}",
			"vhost": "Relativity",
			"configure": ".*",
			"write": ".*",
			"read": ".*"
		},
		{
			"user": "{{ rabbitmq_creds.rabbitadmin_user }}",
			"vhost": "/",
			"configure": ".*",
			"write": ".*",
			"read": ".*"
		},
		{
			"user": "{{ rabbitmq_creds.reladmin_user }}",
			"vhost": "Relativity",
			"configure": ".*",
			"write": ".*",
			"read": ".*"
		}
	],
	"policies": [{
		"vhost": "/",
		"name": "ha-all",
		"pattern": "",
		"apply-to": "all",
		"definition": {
			"ha-mode": "all"
		},
		"priority": 0
	}]
}
